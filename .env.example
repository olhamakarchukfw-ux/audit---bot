# Зразок налаштувань. Справжні значення вписуються тільки в Railway → Variables.
# У цьому файлі немає ключів, тому його можна зберігати в GitHub.

# ---------- Секрети ----------

# Токен від @BotFather
BOT_TOKEN=
# Ключ Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Ключ Apify (apify.com → Settings → API & Integrations)
APIFY_TOKEN=
# Адреса опублікованого Apps Script
SHEETS_WEBHOOK_URL=
# Будь-яке довге слово-пароль, однакове тут і в Apps Script
SHEETS_SECRET=
# Telegram ID Ольги (бот покаже його командою /id)
OWNER_TELEGRAM_ID=
# Тестові акаунти, яким дозволено /reset (Telegram ID через кому, необов'язково)
TESTER_TELEGRAM_IDS=
# Адреса бота на Railway, наприклад https://audit-bot.up.railway.app
PUBLIC_URL=
# Нік бота без @, наприклад olha_audit_bot
BOT_USERNAME=

# ---------- Налаштування ----------

CLAUDE_MODEL=claude-sonnet-5-5
# Глибина роздумів Claude: low, medium, high (за замовчуванням high)
CLAUDE_EFFORT=high
# Ліміт довжини відповіді разом з роздумами
CLAUDE_MAX_TOKENS=48000
DELAY_MIN_MINUTES=120
DELAY_MAX_MINUTES=180
QUIET_FROM=22
QUIET_TO=9
TIMEZONE=Europe/Kiev
DB_PATH=/data/bot.db

# ---------- Дотиски після аудиту ----------

# Посилання на Telegram-канал Ольги (без нього запрошення в канал не надсилаються)
CHANNEL_URL=https://t.me/blognamilion
# Нагадування про діагностику, якщо не натиснули кнопку (годин після аудиту)
REMIND_AFTER_HOURS=24
# Запрошення в канал після нагадування (годин)
CHANNEL_AFTER_REMINDER_HOURS=48
# Запрошення в канал після натискання «Діагностика» (годин)
CHANNEL_AFTER_DIAG_HOURS=72
# Через скільки годин після заявки бот питає Ольгу, чи людина прийшла (168 = тиждень)
ASK_OWNER_AFTER_HOURS=168
